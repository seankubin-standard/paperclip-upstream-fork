DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=paperclip-dev-tool-action-signing-secret-change-me

# App display name (used in email templates and TOTP issuer)
# APP_NAME=Dr. Clippy

# ── Email transport (for password reset emails) ──────────────────────────────
# Provider: "resend" (default) or "smtp"
# EMAIL_PROVIDER=resend
#
# From address shown in outgoing emails
# EMAIL_FROM=Dr. Clippy <noreply@drclippy.com>
#
# Resend (recommended for drclippy.com hosted installs — scoped, rotatable key)
# RESEND_API_KEY=re_...
#
# SMTP (self-hosted / generic transactional provider)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=secret
# ─────────────────────────────────────────────────────────────────────────────

# Microsoft Entra ID / M365 SSO (optional)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
